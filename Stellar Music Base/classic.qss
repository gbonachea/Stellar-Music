/* Stellar Classic Blue. The two display colours also drive the FFT and scope. */
QWidget {color:#14263d; font-family:"DejaVu Sans";font-size:12px}
QWidget#chassis {border:2px solid #111c30;border-radius:13px;background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #a9c4da,stop:.015 #29426a,stop:.07 #101d3c,stop:.11 #253e60,stop:.94 #394d65,stop:.98 #0b1424,stop:1 #627585)}
QFrame#alloy,QDialog,PlaylistWindow {border:1px solid #626f7e;border-radius:7px;background:qlineargradient(x1:0,y1:0,x2:.18,y2:1,stop:0 #fafbfc,stop:.22 #e0e2e7,stop:.48 #bac3ce,stop:.75 #a1adbb,stop:.77 #d1d5dc,stop:.8 #f9fafb,stop:1 #b5becb)}
QLabel#title {color:#c3d4e4;font-size:15px;font-weight:bold;letter-spacing:2px}
QFrame#rail {border-radius:2px;border:1px solid #0a1224;background:#99aabb}
QPushButton {min-width:24px;border:2px solid #5e6976;border-bottom-color:#28384b;border-radius:10px;padding:2px 6px;font-weight:bold;background:qlineargradient(x1:0,y1:0,x2:.1,y2:1,stop:0 white,stop:.25 #fafafa,stop:.52 #d6dce4,stop:.55 #b5becb,stop:1 #edf1f6)}
TransportButton {min-width:46px;max-width:46px;min-height:46px;max-height:46px;padding:0;border:0;qproperty-metal:#e0e5eb;qproperty-accent:#0079cf}
QPushButton:hover {border-color:#3389cb;color:#0a62a8}
QPushButton:pressed,QPushButton:checked {color:#dff5ff;border-color:#425870;background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #152c4c,stop:1 #2379b6)}
QPushButton:disabled {color:#748396}
QPushButton#windowButton {min-width:0;border:1px solid #152437;border-radius:3px;padding:0;color:#162c48;font-size:14px}
QMenuBar {background:transparent;border-bottom:1px solid #8994a3;font-size:14px}
QMenuBar::item {padding:3px 9px;background:transparent}
QMenuBar::item:selected,QMenu::item:selected {background:#265b90;color:white}
QMenu {background:#e5e9ef;color:#18283b}
QSlider::groove:horizontal {height:5px;background:#27374e;border:1px solid #637184;border-radius:3px}
QSlider::sub-page:horizontal {background:#398ac1;border-radius:2px}
QSlider::handle:horizontal {width:23px;margin:-4px 0;border:2px solid #445264;border-radius:6px;background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 white,stop:.5 #e4e9ef,stop:1 #99a6b7)}
QListWidget,QTableView {background:#0b213e;color:#dcf1ff;selection-background-color:#265f91;selection-color:white;border:2px solid #64758a}
QWidget#glass {font-family:"DejaVu Sans Mono";qproperty-ink:#dcf4ff;qproperty-glass:#073774}
